# github-mcp environment (copy to .env; read tools work without secrets)

MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_PATH=/mcp
MCP_KEYS_FILE=keys.example.json

MCP_METRICS_BACKEND=prometheus
MCP_METRICS_PORT=9464
LOG_LEVEL=info

MCP_UPSTREAM_TIMEOUT_S=4.0
MCP_UPSTREAM_RETRIES=2
MCP_BREAKER_THRESHOLD=5
MCP_BREAKER_COOLDOWN_S=30

# Required for the premium write tools (create_issue, add_issue_comment) and to
# raise read rate limits. Create a fine-grained PAT with issues:write scope.
# GITHUB_TOKEN=ghp_your_token_here
